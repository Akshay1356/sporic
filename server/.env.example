# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon PostgreSQL connection string
# Get this from your Neon project dashboard -> Connection Details
# Must include ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-12345.ap-southeast-1.aws.neon.tech/sporic?sslmode=require"

# better-auth
# Generate a strong secret: openssl rand -base64 32
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth (optional social login, leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_SPORIC2026Key
RAZORPAY_KEY_SECRET=rzp_secret_SPORIC2026SecretKey
RAZORPAY_WEBHOOK_SECRET=sporic_webhook_secret_2026

# Admin Bootstrap
INITIAL_ADMIN_EMAIL=admin@vit.ac.in

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=15

# SMTP / Email Configuration (used to deliver the OTP emails via better-auth)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="VIT-TEC SpoRIC <your_email@gmail.com>"
