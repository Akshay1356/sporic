{
  "openapi": "3.0.3",
  "info": {
    "title": "SPORIC / VIT-TEC API Documentation",
    "description": "Complete REST API specification for the Sponsored Research and Industrial Consultancy (SpoRIC) and VIT Technology Enhancement Centre (VIT-TEC) platform.",
    "version": "1.0.0",
    "contact": {
      "name": "Dean, SpoRIC",
      "email": "deancc.sporic@vit.ac.in",
      "url": "https://vit-tec.vit.ac.in"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000/api",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your JWT Bearer token"
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Register a new user account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "fullName"],
                "properties": {
                  "email": { "type": "string", "example": "arun@example.com" },
                  "fullName": { "type": "string", "example": "Arun Kumar" },
                  "password": { "type": "string", "example": "Student@VIT2026" },
                  "phone": { "type": "string", "example": "+91 9876543210" },
                  "organization": { "type": "string", "example": "TCS Innovation Labs" },
                  "role": { "type": "string", "enum": ["STUDENT", "FACULTY"], "default": "STUDENT" },
                  "otp": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" },
          "400": { "description": "Missing required fields or invalid OTP" },
          "409": { "description": "User already exists" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate user with email and password",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "admin@vit.ac.in" },
                  "password": { "type": "string", "example": "Admin@VIT2026" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful and returns JWT token" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/google": {
      "post": {
        "summary": "Authenticate user via Google OAuth 2.0 ID Token",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["idToken"],
                "properties": {
                  "idToken": { "type": "string", "example": "mock_google_token_student1@vit.ac.in" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated successfully" },
          "401": { "description": "Invalid Google OAuth ID token" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Get authenticated user profile and role details",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile data retrieved" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/courses": {
      "get": {
        "summary": "List filterable and searchable courses catalog",
        "tags": ["Courses"],
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" }, "description": "Search by title, code or description" },
          { "name": "domain", "in": "query", "schema": { "type": "string" }, "description": "Technology, Management, Leadership" },
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Category name (e.g. Industry 4.0)" },
          { "name": "mode", "in": "query", "schema": { "type": "string" }, "description": "online, offline, blended" }
        ],
        "responses": {
          "200": { "description": "List of courses" }
        }
      },
      "post": {
        "summary": "Create a new course (Admin only)",
        "tags": ["Courses"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": { "description": "Course created" },
          "403": { "description": "Requires ADMIN role" }
        }
      }
    },
    "/courses/{identifier}": {
      "get": {
        "summary": "Get course details by courseCode (e.g. TECH004) or ID",
        "tags": ["Courses"],
        "parameters": [
          { "name": "identifier", "in": "path", "required": true, "schema": { "type": "string" }, "example": "TECH004" }
        ],
        "responses": {
          "200": { "description": "Detailed course specification" },
          "404": { "description": "Course not found" }
        }
      }
    },
    "/payments/create-order": {
      "post": {
        "summary": "Create a Razorpay order for course enrollment",
        "tags": ["Payments"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["courseId"],
                "properties": {
                  "courseId": { "type": "string", "example": "TECH004" },
                  "batchId": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Razorpay order created with orderId and amount" }
        }
      }
    },
    "/payments/verify": {
      "post": {
        "summary": "Verify Razorpay signature server-side and create enrollment",
        "tags": ["Payments"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["razorpayOrderId", "razorpayPaymentId", "razorpaySignature"],
                "properties": {
                  "razorpayOrderId": { "type": "string" },
                  "razorpayPaymentId": { "type": "string" },
                  "razorpaySignature": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Signature verified and enrollment confirmed" },
          "400": { "description": "Invalid signature" }
        }
      }
    },
    "/student/dashboard": {
      "get": {
        "summary": "Get student learning dashboard, courses & stats",
        "tags": ["Student Learning"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Student dashboard data" }
        }
      }
    },
    "/funding/opportunities": {
      "get": {
        "summary": "List open faculty funding and grant opportunities",
        "tags": ["Funding & Grants"],
        "responses": {
          "200": { "description": "List of opportunities" }
        }
      }
    },
    "/funding/applications": {
      "post": {
        "summary": "Submit or save draft faculty research funding proposal",
        "tags": ["Funding & Grants"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "201": { "description": "Proposal saved or submitted" },
          "403": { "description": "Requires FACULTY role" }
        }
      }
    },
    "/certificates/verify/{certificateId}": {
      "get": {
        "summary": "Public verification of course completion certificate",
        "tags": ["Certificates"],
        "parameters": [
          { "name": "certificateId", "in": "path", "required": true, "schema": { "type": "string" }, "example": "VITTEC-CERT-2026-1001" }
        ],
        "responses": {
          "200": { "description": "Verification details and status" },
          "404": { "description": "Certificate not found" }
        }
      }
    },
    "/admin/analytics": {
      "get": {
        "summary": "Retrieve platform administrative metrics and financial analytics",
        "tags": ["Admin Operations"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Executive platform analytics" },
          "403": { "description": "Requires ADMIN role" }
        }
      }
    },
    "/contact": {
      "post": {
        "summary": "Submit a public inquiry to the SpoRIC desk",
        "tags": ["Public Inquiries"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "subject", "message"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "subject": { "type": "string" },
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Inquiry recorded" }
        }
      }
    }
  }
}
